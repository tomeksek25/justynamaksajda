---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { settings } from '../lib/settings';
import { getWorks, workAlt, workUrl } from '../lib/works';

const works = await getWorks();
const featured = works.filter((w) => w.data.featured);
const slides = featured.length ? featured : works.slice(0, 6);
---

<Base>
  <h1 class="visually-hidden">{settings.artistName} – paintings</h1>
  <section class="container hero" aria-roledescription="carousel" aria-label="Selected works">
    <div class="slides">
      {
        slides.map((work, i) => (
          <figure class="slide" data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} hidden={i > 0}>
            <a href={workUrl(work)}>
              <Image
                src={work.data.image}
                alt={workAlt(work)}
                widths={[700, 1100, 1500, 1900]}
                sizes="(min-width: 1200px) 70vw, 92vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </a>
            <figcaption>
              <a href={workUrl(work)}><span class="title">{work.data.title}</span>{work.data.year && <>, {work.data.year}</>}</a>
              <span class="meta">{[work.data.medium, work.data.dimensions].filter(Boolean).join(' · ')}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    {
      slides.length > 1 && (
        <div class="controls">
          <button type="button" data-prev aria-label="Previous work">←</button>
          <span class="counter"><span data-index>1</span> / {slides.length}</span>
          <span class="visually-hidden" aria-live="polite" data-announce></span>
          <button type="button" data-next aria-label="Next work">→</button>
          <button type="button" class="pause" data-pause aria-pressed="false" hidden>Pause</button>
        </div>
      )
    }
  </section>

  <section class="container intro">
    <p class="eyebrow">{settings.tagline}</p>
    <p class="lead">{settings.homeIntro}</p>
    <p class="links"><a href="/works/">View works</a> <span aria-hidden="true">·</span> <a href="/contact/">Get in touch</a></p>
  </section>
</Base>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  const indexEl = document.querySelector('[data-index]');
  const announcer = document.querySelector('[data-announce]');
  const hero = document.querySelector<HTMLElement>('.hero');
  let current = 0;
  let timer: number | undefined;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Start fetching the slide after the current one so it's ready before it fades in.
  function preloadNext() {
    const img = slides[(current + 1) % slides.length]?.querySelector('img');
    if (img) img.loading = 'eager';
  }

  // Only manual navigation is announced to screen readers, not autoplay.
  function show(i: number, announce = false) {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, n) => (s.hidden = n !== current));
    if (indexEl) indexEl.textContent = String(current + 1);
    if (announce && announcer) announcer.textContent = `Slide ${current + 1} of ${slides.length}`;
    preloadNext();
  }

  // Autoplay runs only while the visitor is neither hovering nor focused inside the slideshow.
  let hovered = false;
  let focused = false;
  let paused = false;
  const autoplay = !reduceMotion && slides.length > 1;
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-pause]');

  function start() {
    stop();
    if (!autoplay || hovered || focused || paused) return;
    timer = window.setInterval(() => show(current + 1), 6000);
  }

  function stop() {
    window.clearInterval(timer);
  }

  // Manual navigation restarts the timer so the chosen slide gets its full time.
  document.querySelector('[data-prev]')?.addEventListener('click', () => (show(current - 1, true), start()));
  document.querySelector('[data-next]')?.addEventListener('click', () => (show(current + 1, true), start()));
  // Touch devices fire enter without a matching leave, so only a real mouse pauses on hover.
  hero?.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && ((hovered = true), start()));
  hero?.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && ((hovered = false), start()));
  hero?.addEventListener('focusin', () => ((focused = true), start()));
  hero?.addEventListener('focusout', (event) => {
    focused = hero.contains(event.relatedTarget as Node | null);
    start();
  });
  if (pauseBtn && autoplay) {
    pauseBtn.hidden = false;
    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.textContent = paused ? 'Play' : 'Pause';
      start();
    });
  }
  if (autoplay) preloadNext();
  start();
</script>

<style>
  .hero {
    padding-top: 56px;
  }

  .slides {
    display: grid;
  }

  .slide {
    grid-area: 1 / 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fade 0.8s ease;
  }

  .slide[hidden] {
    display: none;
  }

  .slide img {
    width: auto;
    max-width: 100%;
    max-height: min(72vh, 900px);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin-top: 18px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
  }

  figcaption a {
    color: var(--text);
    text-decoration: none;
  }

  .title {
    font-style: italic;
  }

  .controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 16px;
    font-size: 13px;
    color: var(--muted);
  }

  .controls button {
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    font-size: 18px;
    cursor: pointer;
    color: var(--muted);
  }

  .controls .pause {
    width: auto;
    padding: 0 8px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .controls button:hover {
    color: var(--text);
  }

  .intro {
    margin-top: 72px;
    text-align: center;
  }

  .lead {
    max-width: 40ch;
    margin: 12px auto 0;
    font-size: 18px;
  }

  .links {
    margin-top: 8px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
