---
import Base from '../../layouts/Base.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { SERIES } from '../../data/series';
import { getWorks, seriesWithWorks } from '../../lib/works';

export async function getStaticPaths() {
  const all = await getWorks();
  const available = seriesWithWorks(all);
  return SERIES.filter((s) => available.includes(s.id)).map((s) => ({
    params: { series: s.id },
    props: { label: s.label, available, works: all.filter((w) => w.data.series === s.id) },
  }));
}

const { series } = Astro.params;
const { label, available, works } = Astro.props;
---

<Base title={label}>
  <div class="container section">
    <h1 class="page-title">Works <span aria-hidden="true">·</span> {label}</h1>
    <SeriesNav current={series} available={available} />
    <WorkGrid works={works} />
  </div>
</Base>

