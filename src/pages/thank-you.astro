</Base>

<script>
  import { clearIfJustSent } from '../scripts/enquiry';

  clearIfJustSent();
</script>

<style>
  .section {
    min-height: 40vh;
  }

  .lead {
    font-size: 20px;
    max-width: 40ch;
  }
</style>
