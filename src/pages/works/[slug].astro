---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EnquiryToggle from '../../components/EnquiryToggle.astro';
import { seriesLabel } from '../../data/series';
import { settings } from '../../lib/settings';
import { AVAILABILITY_LABELS, canEnquire, getWorks, workAlt, workSummary, workUrl, type Work } from '../../lib/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      prev: works[i - 1] as Work | undefined,
      next: works[i + 1] as Work | undefined,
    },
  }));
}

const { work, prev, next } = Astro.props;
const { title, year, medium, dimensions, availability, price, series, image } = work.data;
const { Content } = await render(work);
const large = await getImage({ src: image, width: Math.min(image.width, 2000), format: 'webp' });
const og = await getImage({ src: image, width: Math.min(image.width, 1200), format: 'jpg' });
const enquirable = canEnquire(work);
---

<Base title={title} description={`${workSummary(work)} – by ${settings.artistName}.`} image={og.src}>
  <div class="container work">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/works/">Works</a>
      <span aria-hidden="true">/</span>
      <a href={`/series/${series}/`}>{seriesLabel(series)}</a>
    </nav>

    <div class="layout">
      <figure class="image">
        <button type="button" class="zoom" data-zoom>
          <span class="visually-hidden">Enlarge image: </span>
          <Image
            src={image}
            alt={workAlt(work)}
            widths={[600, 900, 1200, 1600]}
            sizes="(min-width: 1000px) 60vw, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </button>
      </figure>

      <div class="details">
        <h1><span class="title">{title}</span>{year && <span class="year">, {year}</span>}</h1>
        <dl>
          {medium && (<><dt class="visually-hidden">Medium</dt><dd>{medium}</dd></>)}
          {dimensions && (<><dt class="visually-hidden">Dimensions</dt><dd>{dimensions}</dd></>)}
          {price && enquirable && (<><dt class="visually-hidden">Price</dt><dd>{price}</dd></>)}
        </dl>
        {availability && <p class={`status status--${availability}`}>{AVAILABILITY_LABELS[availability]}</p>}

        <div class="description prose"><Content /></div>

        {
          enquirable && (
            <div class="cta">
              <a class="btn" href={`/contact/?work=${encodeURIComponent(work.id)}`}>
                Enquire about this work
              </a>
              <EnquiryToggle slug={work.id} title={title} variant="button" />
              <p class="hint">
                Interested in several works? Add them to your enquiry list and send one message about all of them.
              </p>
            </div>
          )
        }
        {
          !enquirable && (
            <p class="hint">
              This work is not available, but similar works or commissions may be.{' '}
              <a href={`/contact/?ref=${encodeURIComponent(work.id)}`}>Get in touch</a>.
            </p>
          )
        }
      </div>
    </div>

    <nav class="pager" aria-label="More works">
      {prev ? <a href={workUrl(prev)} rel="prev">← <span class="title">{prev.data.title}</span><span class="short">Previous</span></a> : <span />}
      <a href="/works/" class="all">All works</a>
      {next ? <a href={workUrl(next)} rel="next"><span class="title">{next.data.title}</span><span class="short">Next</span> →</a> : <span />}
    </nav>
  </div>

  <dialog class="lightbox" aria-label={title}>
    <form method="dialog">
      <button class="close" aria-label="Close">×</button>
    </form>
    <img src={large.src} alt={workAlt(work)} loading="lazy" decoding="async" />
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const zoom = document.querySelector('[data-zoom]');
  zoom?.addEventListener('click', () => dialog?.showModal());
  // Start loading the large image as soon as the visitor shows intent to open it.
  const preload = () => {
    const img = dialog?.querySelector('img');
    if (img) img.loading = 'eager';
  };
  for (const type of ['pointerenter', 'focus', 'touchstart']) zoom?.addEventListener(type, preload, { once: true });
  // Clicking anywhere outside the close button (including the image) closes the viewer.
  dialog?.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.close')) dialog.close();
  });
</script>

<style>
  .work {
    padding-top: 32px;
  }

  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 32px;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .image {
    margin: 0;
  }

  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .zoom img {
    width: auto;
    max-width: 100%;
    max-height: 78vh;
    margin: 0 auto;
  }

  .details {
    position: sticky;
    top: 32px;
  }

  h1 {
    font-size: clamp(22px, 2.4vw, 30px);
    margin: 0 0 16px;
  }

  .title {
    font-style: italic;
  }

  .year {
    font-style: normal;
  }

  dl {
    margin: 0 0 12px;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .description:not(:empty) {
    margin: 24px 0;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    max-width: 340px;
    margin-top: 32px;
  }

  .hint {
    font-size: 13px;
    color: var(--muted);
    margin: 4px 0 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
  }

  .pager a {
    text-decoration: none;
    color: var(--muted);
  }

  .pager a:hover {
    color: var(--text);
  }

  .pager [rel='next'] {
    text-align: right;
  }

  .pager .short {
    display: none;
  }

  .pager .all {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 24px;
    border: 0;
    background: rgba(255, 255, 255, 0.98);
    cursor: zoom-out;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgba(255, 255, 255, 0.98);
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 48px);
    max-height: calc(100dvh - 48px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .close {
    position: fixed;
    top: 12px;
    right: 16px;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    font-size: 32px;
    font-weight: 300;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .details {
      position: static;
    }

    .cta {
      max-width: none;
    }

    .pager .title {
      display: none;
    }

    .pager .short {
      display: inline;
    }
  }
</style>
