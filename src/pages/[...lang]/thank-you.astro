---
import Base from '../../layouts/Base.astro';
import { localeFromUrl, localeParams, localePath, useTranslations } from '../../lib/i18n';

export const getStaticPaths = localeParams;

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Base title={t('thanks.title')} canonical={false} noindex>
  <div class="container section">
    <h1 class="page-title">{t('thanks.title')}</h1>
    <p class="lead">{t('thanks.text')}</p>
    <p><a href={localePath(locale, '/works/')}>{t('thanks.back')}</a></p>
  </div>
</Base>

<script>
  import { clearIfJustSent } from '../../scripts/enquiry';

  clearIfJustSent();
</script>

<style>
  .section {
    min-height: 40vh;
  }

  .lead {
    font-size: 20px;
    max-width: 40ch;
  }
</style>
