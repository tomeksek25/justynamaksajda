---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { DEFAULT_LOCALE, localeFromUrl, localeParams } from '../../lib/i18n';
import { getSettings } from '../../lib/settings';

export const getStaticPaths = localeParams;

const locale = localeFromUrl(Astro.url);
const settings = getSettings(locale);
// A missing translation falls back to the Polish page.
const page = (await getEntry('pages', `${locale}/about`)) ?? (await getEntry('pages', `${DEFAULT_LOCALE}/about`));
if (!page) throw new Error(`Missing src/content/pages/${DEFAULT_LOCALE}/about.md`);
const { Content } = await render(page);
const { title, portrait, portraitCaption } = page.data;
// Mark the fallback text as Polish so screen readers pronounce it correctly.
const textLang = page.id.startsWith(`${locale}/`) ? undefined : DEFAULT_LOCALE;
---

<Base title={title}>
  <div class="container section">
    <h1 class="page-title" lang={textLang}>{title}</h1>
    <div class={portrait ? 'layout' : undefined}>
      {
        portrait && (
          <figure class="portrait">
            <Image src={portrait} alt={portraitCaption || settings.artistName} lang={portraitCaption ? textLang : undefined} widths={[400, 800]} sizes="(min-width: 900px) 30vw, 92vw" />
            {portraitCaption && <figcaption lang={textLang}>{portraitCaption}</figcaption>}
          </figure>
        )
      }
      <div class="prose" lang={textLang}>
        <Content />
      </div>
    </div>
  </div>
</Base>

<style>

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .portrait {
    margin: 0;
  }

  figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
