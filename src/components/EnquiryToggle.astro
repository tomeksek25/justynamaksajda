---
import { localeFromUrl, useTranslations } from '../lib/i18n';

interface Props {
  slug: string;
  title: string;
  /** Set when the title is shown untranslated (see workText). */
  titleLang?: string;
  variant?: 'link' | 'button';
}

const { slug, title, titleLang, variant = 'link' } = Astro.props;
const t = useTranslations(localeFromUrl(Astro.url));
const labelOff = variant === 'button' ? t('enquiry.addLong') : t('enquiry.add');
const labelOn = variant === 'button' ? t('enquiry.addedLong') : t('enquiry.added');
---

<button
  type="button"
  class={variant === 'button' ? 'btn btn--ghost' : 'link-button'}
  data-enquiry-toggle
  data-slug={slug}
  data-label-off={labelOff}
  data-label-on={labelOn}
  aria-pressed="false"
>
  {variant === 'link' && <span class="icon" aria-hidden="true"></span>}
  <span data-label aria-hidden="true">{labelOff}</span>
  <span class="visually-hidden">{t('enquiry.listPrefix')}<span lang={titleLang}>{title}</span></span>
</button>
