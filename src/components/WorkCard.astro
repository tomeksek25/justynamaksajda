---
import { Image } from 'astro:assets';
import EnquiryToggle from './EnquiryToggle.astro';
import { AVAILABILITY_LABELS, canEnquire, workAlt, workUrl, type Work } from '../lib/works';

interface Props {
  work: Work;
  eager?: boolean;
}

const { work, eager = false } = Astro.props;
const { title, year, medium, dimensions, availability, image } = work.data;
const showEnquiry = canEnquire(work);
---

<article class="work-card">
  <a class="frame" href={workUrl(work)} tabindex="-1" aria-hidden="true">
    <Image
      src={image}
      alt={workAlt(work)}
      widths={[360, 540, 720, 1080]}
      sizes="(min-width: 1440px) 420px, (min-width: 1001px) 30vw, (min-width: 541px) 46vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </a>
  <div class="caption">
    <h2><a href={workUrl(work)}><span class="title">{title}</span>{year && <>, {year}</>}</a></h2>
    {medium && <p>{medium}</p>}
    {dimensions && <p>{dimensions}</p>}
    <div class="actions">
      {
        availability && (
          <span class={`status status--${availability}`}>{AVAILABILITY_LABELS[availability]}</span>
        )
      }
      {showEnquiry && <EnquiryToggle slug={work.id} title={title} />}
    </div>
  </div>
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
  }

  .frame {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--faint);
    overflow: hidden;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.3s;
  }

  .frame:hover img {
    opacity: 0.88;
  }

  .caption {
    padding-top: 14px;
    font-size: 14px;
    color: var(--muted);
  }

  h2 {
    margin: 0 0 2px;
    font-size: 15px;
    font-weight: 300;
    color: var(--text);
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover .title {
    text-decoration: underline;
  }

  .title {
    font-style: italic;
  }

  p {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 18px;
    margin-top: 6px;
  }
</style>
