---
import Base from '../layouts/Base.astro';
import { localeFromUrl, localePath, useTranslations } from '../lib/i18n';

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const text = t('notFound.text', { works: localePath(locale, '/works/'), home: localePath(locale, '/') });
---

<Base title={t('notFound.title')} canonical={false} translated={false} noindex>
  <div class="container section">
    <h1 class="page-title">{t('notFound.title')}</h1>
    <p set:html={text} />
  </div>
</Base>

<style>
  .section {
    min-height: 40vh;
  }
</style>
