---
import { localeFromUrl, localePath, useTranslations } from '../lib/i18n';
import { getSeries, seriesUrl } from '../lib/series';

interface Props {
  current?: string;
  available: string[];
}

const { current, available } = Astro.props;
const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const items = [
  { href: localePath(locale, '/works/'), label: t('works.all'), lang: undefined, active: !current },
  ...getSeries(locale)
    .filter((s) => available.includes(s.id))
    .map((s) => ({
      href: seriesUrl(s, locale),
      label: s.title,
      lang: s.lang.title,
      active: current === s.id,
    })),
];
---

<nav class="series-nav" aria-label={t('works.series')}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} lang={item.lang} aria-current={item.active ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .series-nav {
    margin: 0 0 48px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }

  a:hover {
    color: var(--text);
  }

  a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--text);
  }
</style>
