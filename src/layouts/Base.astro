---
import '@fontsource/lato/300.css';
import '@fontsource/lato/300-italic.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/400-italic.css';
import '@fontsource/lato/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FALLBACK_LOCALE, LOCALE_TAGS, languageLinks, localeFromUrl, useTranslations } from '../lib/i18n';
import { getSettings } from '../lib/settings';
import { canEnquire, getWorks } from '../lib/works';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Pages like the 404 should not declare a canonical URL. */
  canonical?: boolean;
  /** False for pages that don't exist in the other language at the same path (the 404 pages). */
  translated?: boolean;
  noindex?: boolean;
}

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const settings = getSettings(locale);
const {
  title,
  description = settings.siteDescription,
  image,
  canonical: withCanonical = true,
  translated = true,
  noindex = false,
} = Astro.props;
// Works that can currently be enquired about; the enquiry list ignores anything else.
const enquirable = (await getWorks()).filter(canEnquire).map((w) => w.id);
const fullTitle = title ? `${title} | ${settings.artistName}` : `${settings.artistName} – ${t('titleSuffix')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Every page exists in each language at the same path, apart from the locale prefix.
const alternates = languageLinks(Astro.url, translated).map((l) => ({ locale: l.locale, href: new URL(l.path, Astro.site).href }));
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {withCanonical && <link rel="canonical" href={canonical} />}
    {withCanonical && translated && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    {withCanonical && translated && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.locale === FALLBACK_LOCALE)?.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={LOCALE_TAGS[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {withCanonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body data-enquirable={JSON.stringify(enquirable)}>
    <a class="skip-link" href="#main">{t('skipLink')}</a>
    <Header translated={translated} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/enquiry';
    </script>
  </body>
</html>
